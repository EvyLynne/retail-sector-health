      "color": "#1F3864"
    },
    "largeTitle": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 16,
      "color": "#1F3864"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1F3864"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1F3864"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#4A4A4A"
    },
    "semiboldLabel": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 9,
      "color": "#1F3864"
    },
    "boldLabel": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 9,
      "color": "#1F3864"
    },
    "largeLabel": {
      "fontFace": "Segoe UI",
      "fontSize": 11,
      "color": "#4A4A4A"
    },
    "smallLabel": {
      "fontFace": "Segoe UI",
      "fontSize": 8,
      "color": "#4A4A4A"
    },
    "lightLabel": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#4A4A4A"
    },
    "largeLightLabel": {
      "fontFace": "Segoe UI",
      "fontSize": 11,
      "color": "#4A4A4A"
    },
    "smallLightLabel": {
      "fontFace": "Segoe UI",
      "fontSize": 8,
      "color": "#4A4A4A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "*": [
          {
            "wordWrap": true
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E1DFDD"
              }
            },
            "radius": 6
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1F3864"
              }
            },
            "fontSize": 12,
            "alignment": "left",
            "titleWrap": true
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#4A4A4A"
              }
            },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E1DFDD"
              }
            },
            "gridlineStyle": "dotted",
            "labelColor": {
              "solid": {
                "color": "#4A4A4A"
              }
            },
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#4A4A4A"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "bubbles": [
          {
            "bubbleSize": -10
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ],
        "fillPoint": [
          {
            "show": true
          }
        ],
        "legend": [
          {
            "show": false
          }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "showMarker": false
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#1F3864"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "lineStyle": "solid",
            "showMarker": false
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 28,
            "color": {
              "solid": {
                "color": "#1F3864"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#4A4A4A"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": {
              "solid": {
                "color": "#E1DFDD"
              }
            },
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E1DFDD"
              }
            },
            "rowPadding": 3,
            "outlineColor": {
              "solid": {
                "color": "#E1DFDD"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1F3864"
              }
            },
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontSize": 9,
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F7F9FC"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#4A4A4A"
              }
            }
          }
        ],
        "subTotals": [
          {
            "rowSubtotals": false,
            "columnSubtotals": false
          }
        ]
      }
    }
  }
}
