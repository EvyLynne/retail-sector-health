// ========================================================================
// 10_seasonality.dax
// U.S. Retail Sector Health - display folder "10 Seasonality"
//
// 5 measures. Build them in the order below; later ones
// reference earlier ones and a missing dependency returns BLANK
// rather than an error.
//
// HOME TABLE     _Measures
// DISPLAY FOLDER 10 Seasonality   (type it exactly, leading number included)
// SOURCE         document 02 section 8. Generated from the same list
//                that produces document 20's Measures tab.
//
// Every measure needs its format string and description set as well
// as its expression - both are given with each one below.
// ========================================================================


// ---- Month Seasonal Factor -----------------------------------------
//   Ratio-to-average factor. Above 1.00 marks a seasonal peak. NOT
//   X-13ARIMA-SEATS — Census applies outlier and trading-day handling
//   this does not, and the page says so.
//   Format      0.00
//   Depends on  Total Cases

Month Seasonal Factor =
    VAR M = SELECTEDVALUE ( DimDate[MonthNumber] )
    VAR SameMonthAvg = CALCULATE ( AVERAGEX ( VALUES ( DimDate[DateKey] ), [Total Cases] ),
                                   ALL ( DimDate ), DimDate[MonthNumber] = M )
    VAR OverallAvg = CALCULATE ( AVERAGEX ( VALUES ( DimDate[DateKey] ), [Total Cases] ), ALL ( DimDate ) )
    RETURN DIVIDE ( SameMonthAvg, OverallAvg )

// ---- Seasonally Adjusted Cases -------------------------------------
//   The trend with seasonality removed, plotted against the raw series
//   on spec 10.5.
//   Format      #,##0
//   Depends on  Month Seasonal Factor, Total Cases

Seasonally Adjusted Cases =
    DIVIDE ( [Total Cases], [Month Seasonal Factor] )

// ---- Seasonal Amplitude --------------------------------------------
//   Spread between the strongest and weakest month. A narrowing spread
//   means seasonality is flattening — itself a consumer-behaviour
//   finding.
//   Format      0.00
//   Depends on  Month Seasonal Factor

Seasonal Amplitude =
    VAR Factors = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( DimDate[MonthNumber] ), ALLSELECTED ( DimDate ) ),
        "@f", [Month Seasonal Factor] )
    RETURN MAXX ( Factors, [@f] ) - MINX ( Factors, [@f] )

// ---- Peak Month ----------------------------------------------------
//   Text measure. Card visuals accept text measures — this is spec
//   10.2.
//   Format      —
//   Depends on  Month Seasonal Factor

Peak Month =
    VAR T = ADDCOLUMNS ( ALL ( DimDate[MonthNumber], DimDate[MonthName] ), "@f", [Month Seasonal Factor] )
    RETURN MAXX ( TOPN ( 1, T, [@f], DESC ), DimDate[MonthName] )

// ---- Trough Month --------------------------------------------------
//   Text measure. Spec 10.3.
//   Format      —
//   Depends on  Month Seasonal Factor

Trough Month =
    VAR T = ADDCOLUMNS ( ALL ( DimDate[MonthNumber], DimDate[MonthName] ), "@f", [Month Seasonal Factor] )
    RETURN MAXX ( TOPN ( 1, T, [@f], ASC ), DimDate[MonthName] )
