// ========================================================================
// 06_elasticity.dax
// U.S. Retail Sector Health - display folder "06 Elasticity"
//
// 12 measures. Build them in the order below; later ones
// reference earlier ones and a missing dependency returns BLANK
// rather than an error.
//
// HOME TABLE     _Measures
// DISPLAY FOLDER 06 Elasticity   (type it exactly, leading number included)
// SOURCE         document 02 section 8. Generated from the same list
//                that produces document 20's Measures tab.
//
// Every measure needs its format string and description set as well
// as its expression - both are given with each one below.
// ========================================================================


// ---- Unemployment Rate ---------------------------------------------
//   Labour slack. Enters the stress composite positively.
//   Format      0.0%
//   Depends on  Macro Value

Unemployment Rate =
    CALCULATE ( [Macro Value], DimIndicator[SeriesId] = "UNRATE" )

// ---- Personal Saving Rate ------------------------------------------
//   Precautionary saving. Enters the stress composite positively.
//   Format      0.0%
//   Depends on  Macro Value

Personal Saving Rate =
    CALCULATE ( [Macro Value], DimIndicator[SeriesId] = "PSAVERT" )

// ---- Real Disposable Income ----------------------------------------
//   Purchasing power, billions of chained dollars.
//   Format      #,##0
//   Depends on  Macro Value

Real Disposable Income =
    CALCULATE ( [Macro Value], DimIndicator[SeriesId] = "DSPIC96" )

// ---- Real Disposable Income YoY % ----------------------------------
//   Tests the income channel separately from the sentiment channel
//   (spec 4.7).
//   Format      0.0%
//   Depends on  Real Disposable Income

Real Disposable Income YoY % =
    VAR Prior = CALCULATE ( [Real Disposable Income], DATEADD ( DimDate[Date], -12, MONTH ) )
    RETURN DIVIDE ( [Real Disposable Income] - Prior, Prior )

// ---- Consumer Stress Index -----------------------------------------
//   Equal-weighted composite of three standardised series.
//   Standardised over ALL dates so the scale does not move when a
//   slicer changes. Sentiment enters NEGATIVE — falling sentiment is
//   rising stress.
//   Format      0.00
//   Depends on  Consumer Sentiment, Personal Saving Rate, Unemployment Rate

Consumer Stress Index =
    VAR AllDates = CALCULATETABLE ( VALUES ( DimDate[DateKey] ), ALL ( DimDate ) )
    VAR UnZ = DIVIDE ( [Unemployment Rate] - AVERAGEX ( AllDates, CALCULATE ( [Unemployment Rate] ) ), STDEVX.P ( AllDates, CALCULATE ( [Unemployment Rate] ) ) )
    VAR SenZ = DIVIDE ( [Consumer Sentiment] - AVERAGEX ( AllDates, CALCULATE ( [Consumer Sentiment] ) ), STDEVX.P ( AllDates, CALCULATE ( [Consumer Sentiment] ) ) )
    VAR SavZ = DIVIDE ( [Personal Saving Rate] - AVERAGEX ( AllDates, CALCULATE ( [Personal Saving Rate] ) ), STDEVX.P ( AllDates, CALCULATE ( [Personal Saving Rate] ) ) )
    RETURN DIVIDE ( UnZ - SenZ + SavZ, 3 )

// ---- Volume Stress Sensitivity -------------------------------------
//   OLS slope of volume growth on the stress composite. Negative:
//   volume falls as stress rises. Near zero supports the
//   inelastic-demand claim. DESCRIPTIVE ONLY — no standard errors, no
//   lags, no controls.
//   Format      0.000
//   Depends on  Consumer Stress Index, Total Cases YoY %

Volume Stress Sensitivity =
    VAR Points = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( DimDate[DateKey] ), ALLSELECTED ( DimDate ) ),
        "@x", [Consumer Stress Index], "@y", [Total Cases YoY %] )
    VAR Known = FILTER ( Points, NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] ) )
    VAR MeanX = AVERAGEX ( Known, [@x] )
    VAR MeanY = AVERAGEX ( Known, [@y] )
    RETURN DIVIDE ( SUMX ( Known, ( [@x] - MeanX ) * ( [@y] - MeanY ) ),
                    SUMX ( Known, ( [@x] - MeanX ) ^ 2 ) )

// ---- Volume Stress Correlation -------------------------------------
//   Pearson r on the same points as Volume Stress Sensitivity.
//   Reported beside the slope so a reader can see how much of the
//   relationship the slope explains. Written out in full rather than
//   as a note, because a measure cannot inherit another measure's
//   variables.
//   Format      0.00
//   Depends on  Consumer Stress Index, Total Cases YoY %

Volume Stress Correlation =
    VAR Points = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( DimDate[DateKey] ), ALLSELECTED ( DimDate ) ),
        "@x", [Consumer Stress Index], "@y", [Total Cases YoY %] )
    VAR Known = FILTER ( Points, NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] ) )
    VAR MeanX = AVERAGEX ( Known, [@x] )
    VAR MeanY = AVERAGEX ( Known, [@y] )
    VAR Cov = SUMX ( Known, ( [@x] - MeanX ) * ( [@y] - MeanY ) )
    RETURN DIVIDE ( Cov, SQRT ( SUMX ( Known, ( [@x] - MeanX ) ^ 2 ) )
                  * SQRT ( SUMX ( Known, ( [@y] - MeanY ) ^ 2 ) ) )

// ---- Observation Count ---------------------------------------------
//   REQUIRED on every visual displaying a slope or a correlation. A
//   coefficient computed on a handful of months is not a finding, and
//   validation check 15 enforces this.
//   Format      #,##0
//   Depends on  Total Cases YoY %

Observation Count =
    COUNTROWS ( FILTER ( CALCULATETABLE ( VALUES ( DimDate[DateKey] ), ALLSELECTED ( DimDate ) ),
                NOT ISBLANK ( [Total Cases YoY %] ) ) )

// ---- Item Type Share % ---------------------------------------------
//   Mix composition. Spec 5.5.
//   Format      0.0%
//   Depends on  Total Cases

Item Type Share % =
    DIVIDE ( [Total Cases], CALCULATE ( [Total Cases], ALL ( DimItem[ItemType] ) ) )

// ---- Item Type Share 2019 Baseline ---------------------------------
//   Pre-disruption mix.
//   Format      0.0%
//   Depends on  Total Cases

Item Type Share 2019 Baseline =
    CALCULATE ( DIVIDE ( [Total Cases], CALCULATE ( [Total Cases], ALL ( DimItem[ItemType] ) ) ),
                ALL ( DimDate ), DimDate[Year] = 2019 )

// ---- Item Type Share vs 2019 (pp) ----------------------------------
//   Separates genuine mix movement from level movement. Spec 5.6.
//   Format      0.0
//   Depends on  Item Type Share %, Item Type Share 2019 Baseline

Item Type Share vs 2019 (pp) =
    ( [Item Type Share %] - [Item Type Share 2019 Baseline] ) * 100

// ---- Mix Shift Magnitude (pp) --------------------------------------
//   How far the whole composition has moved from its 2019 mix, in
//   percentage points. Halved because share changes sum to zero, so
//   the absolute total double-counts every move. Replaces the retired
//   Premium Tier Share %: there is no price data in this project, so a
//   price-tier measure had no derivable basis. A flat Total Cases YoY
//   % with a rising value here is the trading-down result stated
//   without needing a price.
//   Format      0.0
//   Depends on  Item Type Share vs 2019 (pp)

Mix Shift Magnitude (pp) =
    VAR Shifts =
        ADDCOLUMNS ( VALUES ( DimItem[ItemType] ), "@d", [Item Type Share vs 2019 (pp)] )
    RETURN
        DIVIDE ( SUMX ( Shifts, ABS ( [@d] ) ), 2 )
