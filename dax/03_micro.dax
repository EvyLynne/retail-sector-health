// ========================================================================
// 03_micro.dax
// U.S. Retail Sector Health - display folder "03 Micro"
//
// 12 measures. Build them in the order below; later ones
// reference earlier ones and a missing dependency returns BLANK
// rather than an error.
//
// HOME TABLE     _Measures
// DISPLAY FOLDER 03 Micro   (type it exactly, leading number included)
// SOURCE         document 02 section 8. Generated from the same list
//                that produces document 20's Measures tab.
//
// Every measure needs its format string and description set as well
// as its expression - both are given with each one below.
// ========================================================================


// ---- Retail Cases --------------------------------------------------
//   CASES to consumers (off-premise). Named in cases deliberately — a
//   measure called 'Retail Sales' beside a Census dollar measure is
//   the most likely source of a false comparison.
//   Format      #,##0
//   Depends on  -

Retail Cases =
    SUM ( FactItemMovement[RetailSales] )

// ---- Warehouse Cases -----------------------------------------------
//   CASES to licensees (on-premise).
//   Format      #,##0
//   Depends on  -

Warehouse Cases =
    SUM ( FactItemMovement[WarehouseSales] )

// ---- Transfer Cases ------------------------------------------------
//   CASES transferred into dispensaries.
//   Format      #,##0
//   Depends on  -

Transfer Cases =
    SUM ( FactItemMovement[RetailTransfers] )

// ---- Total Cases ---------------------------------------------------
//   Retail + warehouse cases. Mix-weighted across item types — a case
//   of beer is not a case of liquor, so cross-type totals are not
//   physical totals.
//   Format      #,##0
//   Depends on  -

Total Cases =
    SUM ( FactItemMovement[TotalMovement] )

// ---- Retail Cases YoY % --------------------------------------------
//   Off-premise volume growth.
//   Format      0.0%
//   Depends on  Retail Cases

Retail Cases YoY % =
    VAR Prior = CALCULATE ( [Retail Cases], DATEADD ( DimDate[Date], -12, MONTH ) )
    RETURN DIVIDE ( [Retail Cases] - Prior, Prior )

// ---- Total Cases YoY % ---------------------------------------------
//   Total volume growth. The ONLY measure permitted to sit against
//   National Liquor Stores Real YoY %.
//   Format      0.0%
//   Depends on  Total Cases

Total Cases YoY % =
    VAR Prior = CALCULATE ( [Total Cases], DATEADD ( DimDate[Date], -12, MONTH ) )
    RETURN DIVIDE ( [Total Cases] - Prior, Prior )

// ---- Retail Share of Movement % ------------------------------------
//   Off-premise share of total movement.
//   Format      0.0%
//   Depends on  Retail Cases, Total Cases

Retail Share of Movement % =
    DIVIDE ( [Retail Cases], [Total Cases] )

// ---- Transfer to Sales Ratio ---------------------------------------
//   Distribution-quality signal: cases moved INTO dispensaries per
//   case sold. A persistently high ratio means product landing where
//   demand is not — a forecasting failure, not a demand signal.
//   Format      0.00
//   Depends on  Retail Cases, Transfer Cases

Transfer to Sales Ratio =
    DIVIDE ( [Transfer Cases], [Retail Cases] )

// ---- Active Items --------------------------------------------------
//   Items with movement in the current filter context.
//   Format      #,##0
//   Depends on  -

Active Items =
    DISTINCTCOUNT ( FactItemMovement[ItemKey] )

// ---- Active Suppliers ----------------------------------------------
//   Suppliers with movement in context.
//   Format      #,##0
//   Depends on  -

Active Suppliers =
    DISTINCTCOUNT ( FactItemMovement[SupplierKey] )

// ---- Top 10 Supplier Share % ---------------------------------------
//   Concentration measure. Paired with Active Suppliers on spec 9.6 —
//   share rising while count holds is a different story from share
//   rising because suppliers left.
//   Format      0.0%
//   Depends on  Total Cases

Top 10 Supplier Share % =
    VAR Top10 = TOPN ( 10, ALLSELECTED ( DimSupplier ), [Total Cases], DESC )
    RETURN DIVIDE ( CALCULATE ( [Total Cases], KEEPFILTERS ( Top10 ) ),
                    CALCULATE ( [Total Cases], ALLSELECTED ( DimSupplier ) ) )

// ---- Return Rows ---------------------------------------------------
//   Count of negative retail rows. A data-quality CONTROL, not a
//   filter: returns and transfers are retained and the card carries a
//   tooltip saying so.
//   Format      #,##0
//   Depends on  -

Return Rows =
    CALCULATE ( COUNTROWS ( FactItemMovement ), FactItemMovement[RetailSales] < 0 )
