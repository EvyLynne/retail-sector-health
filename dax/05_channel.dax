// ========================================================================
// 05_channel.dax
// U.S. Retail Sector Health - display folder "05 Channel"
//
// 9 measures. Build them in the order below; later ones
// reference earlier ones and a missing dependency returns BLANK
// rather than an error.
//
// HOME TABLE     _Measures
// DISPLAY FOLDER 05 Channel   (type it exactly, leading number included)
// SOURCE         document 02 section 8. Generated from the same list
//                that produces document 20's Measures tab.
//
// Every measure needs its format string and description set as well
// as its expression - both are given with each one below.
// ========================================================================


// ---- Off-Premise Cases ---------------------------------------------
//   Alias with channel semantics. Exists so the channel panel reads in
//   channel language rather than source-column language.
//   Format      #,##0
//   Depends on  Retail Cases

Off-Premise Cases =
    [Retail Cases]

// ---- On-Premise Cases ----------------------------------------------
//   Cases to licensees — bars and restaurants.
//   Format      #,##0
//   Depends on  Warehouse Cases

On-Premise Cases =
    [Warehouse Cases]

// ---- On-Premise Share % --------------------------------------------
//   Share of movement going to on-premise accounts.
//   Format      0.0%
//   Depends on  On-Premise Cases, Total Cases

On-Premise Share % =
    DIVIDE ( [On-Premise Cases], [Total Cases] )

// ---- Keg Cases -----------------------------------------------------
//   Kegs are almost never sold for home consumption, so this is close
//   to an uncontaminated on-premise indicator.
//   Format      #,##0
//   Depends on  Total Cases

Keg Cases =
    CALCULATE ( [Total Cases], DimItem[ItemType] = "Kegs" )

// ---- Keg Share % ---------------------------------------------------
//   Spec 3.11. Moves earlier and harder than the blended channel
//   series.
//   Format      0.0%
//   Depends on  Keg Cases, Total Cases

Keg Share % =
    DIVIDE ( [Keg Cases], [Total Cases] )

// ---- On-Premise Share 2019 Baseline --------------------------------
//   The last complete pre-disruption year. Must return a value under
//   every slicer combination used on R1 Page 3 — a blank baseline
//   silently blanks every vs-2019 measure downstream.
//   Format      0.0%
//   Depends on  On-Premise Cases, Total Cases

On-Premise Share 2019 Baseline =
    CALCULATE ( DIVIDE ( [On-Premise Cases], [Total Cases] ),
                ALL ( DimDate ), DimDate[Year] = 2019 )

// ---- On-Premise Share vs 2019 (pp) ---------------------------------
//   Negative and persistent: consumption relocated to the home and
//   stayed. Returning toward zero: the shift was transitory. Spec
//   3.10.
//   Format      0.0
//   Depends on  On-Premise Share %, On-Premise Share 2019 Baseline

On-Premise Share vs 2019 (pp) =
    ( [On-Premise Share %] - [On-Premise Share 2019 Baseline] ) * 100

// ---- On-Premise Cases vs 2019 Same Month % -------------------------
//   Level recovery against the pre-disruption comparable month, which
//   controls for seasonality without modelling it.
//   Format      0.0%
//   Depends on  On-Premise Cases

On-Premise Cases vs 2019 Same Month % =
    VAR Base = CALCULATE ( [On-Premise Cases], ALL ( DimDate ),
                           VALUES ( DimDate[MonthNumber] ), DimDate[Year] = 2019 )
    RETURN DIVIDE ( [On-Premise Cases] - Base, Base )

// ---- Channel Divergence (pp) ---------------------------------------
//   Off-premise growth less on-premise growth. The 2020 spike states
//   the substitution effect as a single number.
//   Format      0.0
//   Depends on  Off-Premise Cases, On-Premise Cases

Channel Divergence (pp) =
    VAR OffPy = CALCULATE ( [Off-Premise Cases], DATEADD ( DimDate[Date], -12, MONTH ) )
    VAR OnPy = CALCULATE ( [On-Premise Cases], DATEADD ( DimDate[Date], -12, MONTH ) )
    RETURN ( DIVIDE ( [Off-Premise Cases] - OffPy, OffPy )
           - DIVIDE ( [On-Premise Cases] - OnPy, OnPy ) ) * 100
