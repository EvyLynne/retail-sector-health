// ========================================================================
// 09_supplier.dax
// U.S. Retail Sector Health - display folder "09 Supplier"
//
// 2 measures. Build them in the order below; later ones
// reference earlier ones and a missing dependency returns BLANK
// rather than an error.
//
// HOME TABLE     _Measures
// DISPLAY FOLDER 09 Supplier   (type it exactly, leading number included)
// SOURCE         document 02 section 8. Generated from the same list
//                that produces document 20's Measures tab.
//
// Every measure needs its format string and description set as well
// as its expression - both are given with each one below.
// ========================================================================


// ---- Supplier HHI --------------------------------------------------
//   Herfindahl-Hirschman Index on a 0–10,000 scale. Below 1,500
//   unconcentrated; above 2,500 highly concentrated. Reference lines
//   at both thresholds on spec 9.5.
//   Format      #,##0
//   Depends on  Total Cases

Supplier HHI =
    VAR Shares = ADDCOLUMNS ( ALLSELECTED ( DimSupplier ), "@vol", [Total Cases] )
    VAR Total = SUMX ( Shares, [@vol] )
    RETURN SUMX ( Shares, ( DIVIDE ( [@vol], Total ) * 100 ) ^ 2 )

// ---- Supplier Return Rate % ----------------------------------------
//   Returned cases as a share of gross cases sold. Evaluated per
//   supplier on a visual; a persistent outlier is a quality or
//   ordering signal.
//   Format      0.0%
//   Depends on  -

Supplier Return Rate % =
    VAR Returned = CALCULATE ( SUM ( FactItemMovement[RetailSales] ), FactItemMovement[RetailSales] < 0 )
    VAR Gross = CALCULATE ( SUM ( FactItemMovement[RetailSales] ), FactItemMovement[RetailSales] > 0 )
    RETURN DIVIDE ( -Returned, Gross )
