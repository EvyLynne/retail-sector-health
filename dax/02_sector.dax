// ========================================================================
// 02_sector.dax
// U.S. Retail Sector Health - display folder "02 Sector"
//
// 10 measures. Build them in the order below; later ones
// reference earlier ones and a missing dependency returns BLANK
// rather than an error.
//
// HOME TABLE     _Measures
// DISPLAY FOLDER 02 Sector   (type it exactly, leading number included)
// SOURCE         document 02 section 8. Generated from the same list
//                that produces document 20's Measures tab.
//
// Every measure needs its format string and description set as well
// as its expression - both are given with each one below.
// ========================================================================


// ---- Sector Sales --------------------------------------------------
//   Nominal sales in millions of DOLLARS. Never place beside a Tier 3
//   case measure.
//   Format      #,##0
//   Depends on  -

Sector Sales =
    SUM ( FactSectorSales[SalesMillionsUSD] )

// ---- Sector Sales PY -----------------------------------------------
//   Prior year, same month.
//   Format      #,##0
//   Depends on  Sector Sales

Sector Sales PY =
    CALCULATE ( [Sector Sales], DATEADD ( DimDate[Date], -12, MONTH ) )

// ---- Sector Sales YoY % --------------------------------------------
//   Nominal growth. Contains price AND volume — spec 2.6 separates
//   them.
//   Format      0.0%
//   Depends on  Sector Sales PY

Sector Sales YoY % =
    DIVIDE ( [Sector Sales] - [Sector Sales PY], [Sector Sales PY] )

// ---- Sector Sales 3M Avg -------------------------------------------
//   Short smoothing.
//   Format      #,##0
//   Depends on  Sector Sales

Sector Sales 3M Avg =
    AVERAGEX ( DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ), -3, MONTH ), [Sector Sales] )

// ---- Sector Sales 12M Avg ------------------------------------------
//   Trend line for the monthly series.
//   Format      #,##0
//   Depends on  Sector Sales

Sector Sales 12M Avg =
    AVERAGEX ( DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ), -12, MONTH ), [Sector Sales] )

// ---- Total Retail and Food Services --------------------------------
//   Headline denominator. ALL(DimCategory) escapes the current
//   category filter so it stays the whole-market total.
//   Format      #,##0
//   Depends on  Sector Sales

Total Retail and Food Services =
    CALCULATE ( [Sector Sales], ALL ( DimCategory ), DimCategory[CategoryCode] = "44X72" )

// ---- Share of Total Retail % ---------------------------------------
//   Blank for aggregates by design — 44X72 as a share of itself is
//   100% and would corrupt spec 2.3.
//   Format      0.0%
//   Depends on  Sector Sales, Total Retail and Food Services

Share of Total Retail % =
    IF ( SELECTEDVALUE ( DimCategory[IsAggregate] ) = FALSE (),
         DIVIDE ( [Sector Sales], [Total Retail and Food Services] ) )

// ---- Real Sector Sales ---------------------------------------------
//   Deflated to 1982-84 dollars. The volume-comparable series and the
//   only national figure that may meet Tier 3.
//   Format      #,##0
//   Depends on  Macro Value, Sector Sales

Real Sector Sales =
    VAR Cpi = CALCULATE ( [Macro Value], ALL ( DimIndicator ), DimIndicator[SeriesId] = "CPIAUCSL" )
    RETURN DIVIDE ( [Sector Sales], Cpi ) * 100

// ---- Real Sector Sales YoY % ---------------------------------------
//   Volume growth with price removed.
//   Format      0.0%
//   Depends on  Real Sector Sales

Real Sector Sales YoY % =
    VAR Curr = [Real Sector Sales]
    VAR Prior = CALCULATE ( [Real Sector Sales], DATEADD ( DimDate[Date], -12, MONTH ) )
    RETURN DIVIDE ( Curr - Prior, Prior )

// ---- Nominal less Real YoY (pp) ------------------------------------
//   The inflation wedge in percentage points: how much of headline
//   growth was price, not quantity. Spec 2.6.
//   Format      0.0
//   Depends on  Real Sector Sales YoY %

Nominal less Real YoY (pp) =
    ( [Sector Sales YoY %] - [Real Sector Sales YoY %] ) * 100
